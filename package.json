{
  "name": "xhf-blob",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "build:cf": "turbo run build:pages --filter=blog",
    "lint": "turbo lint",
    "start": "pnpm --filter blog start",
    "dev:assistant": "pnpm --filter assistant dev",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "assistant:ingest": "pnpm --filter assistant ingest",
    "assistant:up": "docker compose up -d postgres assistant"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=18.18.0"
  }
}
